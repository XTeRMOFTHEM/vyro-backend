# ============ VYRO Backend — Environment Config ============
# این فایل را به .env کپی کنید و مقادیر را برای محیط production تغییر دهید

APP_NAME=VYRO
ENV=dev                      # dev | staging | prod
DEBUG=true
API_V1_PREFIX=/api/v1

# ---------- Database (PostgreSQL) ----------
DATABASE_URL=postgresql+asyncpg://vyro:vyro_secret@127.0.0.1:5432/vyro
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_ECHO=false

# ---------- Redis (اختیاری — برای cache/rate-limit چند‌سروریه) ----------
# اگر ست نشود، از fallback حافظه‌ای استفاده می‌شود (تک‌instance)
REDIS_URL=

# ---------- Security / JWT ----------
# در production حتماً یک مقدار تصادفی طولانی بگذارید: openssl rand -hex 64
JWT_SECRET=change-me-in-production-9f8a7b6c5d4e3f2a1b0c
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
EMAIL_TOKEN_EXPIRE_HOURS=24
RESET_TOKEN_EXPIRE_HOURS=1

# ---------- Email ----------
EMAIL_VERIFICATION_REQUIRED=true
# در حالت dev (وقتی SMTP تنظیم نشده) توکن تایید در پاسخ ثبت‌نام برگردانده می‌شود
DEV_EXPOSE_EMAIL_TOKENS=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=VYRO <no-reply@vyro.app>

# ---------- Media / Upload ----------
MEDIA_ROOT=./media
MAX_UPLOAD_SIZE_MB=10
MAX_IMAGES_PER_POST=4

# ---------- Rate Limit (تعداد/ثانیه) ----------
RATE_LIMIT_GLOBAL=300/60
RATE_LIMIT_AUTH=10/60

# ---------- Economy (کوین ZYRA) ----------
SIGNUP_BONUS_ZYRA=100
DAILY_BONUS_ZYRA=25
BUFF_MIN=1
BUFF_MAX=10000

# ---------- Profile ----------
USERNAME_CHANGE_COOLDOWN_DAYS=7

# ---------- CORS ----------
CORS_ORIGINS=*

# ---------- Seed Admin ----------
ADMIN_EMAIL=admin@vyro.app
ADMIN_PASSWORD=Admin@1234
ADMIN_USERNAME=vyro_admin
